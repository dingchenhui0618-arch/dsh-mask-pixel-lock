{
  "name": "dsh-mask-pixel-lock",
  "version": "0.1.0",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "description": "Prove a local image edit left every pixel outside the mask untouched: pixel comparison, difference heatmap and a SHA-256 proof report.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "mask-pixel-lock": "./bin/mask-pixel-lock.mjs"
  },
  "files": [
    "lib",
    "bin",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image",
    "inpainting",
    "mask",
    "pixel-diff",
    "proof",
    "sha256",
    "png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-mask-pixel-lock.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-mask-pixel-lock#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-mask-pixel-lock/issues"
  },
  "license": "MIT"
}
